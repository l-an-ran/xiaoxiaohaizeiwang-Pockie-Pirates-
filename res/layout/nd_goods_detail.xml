<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:fadingEdge="none" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <RelativeLayout android:id="@id/nd_goods_price_rl" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" style="@style/nd3_option_item_margin_style">
                <RelativeLayout android:id="@id/nd_goods_detail_left_rl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/nd3_margin_size" android:layout_alignParentTop="true">
                    <ImageView android:id="@id/nd_goods_icon" android:layout_width="@dimen/nd_goods_detail_size" android:layout_height="@dimen/nd_goods_detail_size" android:src="@drawable/nd_goods_detail_default" android:scaleType="fitXY" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" />
                    <LinearLayout android:orientation="horizontal" android:id="@id/nd_goods_count_rl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/nd3_margin_size" android:layout_below="@id/nd_goods_icon">
                        <Button android:layout_gravity="center_vertical" android:id="@id/nd_reduce_goods" android:background="@drawable/nd_button_action_reduce" android:layout_width="28.0dp" android:layout_height="25.0dp" android:layout_marginLeft="@dimen/nd3_margin_size" />
                        <EditText android:id="@id/nd_goods_count" android:background="@drawable/nd_goods_count_input_bg" android:layout_width="70.0dp" android:layout_height="30.0dp" android:singleLine="true" android:numeric="integer" />
                        <Button android:layout_gravity="center_vertical" android:id="@id/nd_add_goods" android:background="@drawable/nd_button_action_add" android:layout_width="28.0dp" android:layout_height="25.0dp" android:layout_marginRight="@dimen/nd3_margin_size" />
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout android:orientation="vertical" android:id="@id/nd_goods_detail_right_rl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/nd3_margin_size" android:layout_toRightOf="@id/nd_goods_detail_left_rl" android:layout_alignParentTop="true">
                    <TextView android:gravity="bottom" android:id="@id/nd_goods_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/nd3_margin_size" style="@style/nd3_textview_1" />
                    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd_goods_price_org" style="@style/nd_goods_item_style" />
                        <TextView android:textSize="14.0sp" android:textColor="@color/nd3_black" android:gravity="bottom" android:id="@id/nd_goods_price_org_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd_goods_price_sale" style="@style/nd_goods_item_style" />
                        <TextView android:textSize="14.0sp" android:textColor="@color/nd3_black" android:gravity="bottom" android:id="@id/nd_goods_price_sale_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <Button android:textColor="@color/nd3_white" android:gravity="center" android:id="@id/nd_to_buy" android:background="@drawable/nd_button_action_buy" android:layout_width="120.0dp" android:layout_height="35.0dp" android:layout_margin="@dimen/nd3_margin_size" android:text="@string/nd_goods_buy_now" />
                </LinearLayout>
            </RelativeLayout>
            <TextView android:textSize="20.0sp" android:textColor="#ffffffff" android:id="@id/nd_goods_desc_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="10.0dp" android:text="@string/nd_goods_desc_panel_title" android:layout_below="@id/nd_goods_price_rl" />
            <LinearLayout android:orientation="vertical" android:id="@id/nd_goods_desc_rl" android:background="@drawable/nd3_bk1" android:padding="@dimen/nd3_option_item_marginLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/nd_goods_desc_title" style="@style/nd3_option_item_margin_style">
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:gravity="fill_horizontal" android:layout_width="80.0dp" android:layout_height="wrap_content" android:text="@string/nd_goods_desc_panel_title1" style="@style/nd_goods_item_style" />
                    <TextView android:gravity="left" android:id="@id/nd_goods_valid_time_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/nd_goods_item_style" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:gravity="fill_horizontal" android:layout_width="80.0dp" android:layout_height="wrap_content" android:text="@string/nd_goods_desc_panel_title2" style="@style/nd_goods_item_style" />
                    <TextView android:gravity="left" android:id="@id/nd_goods_use_time_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/nd_goods_item_style" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:gravity="fill_horizontal" android:layout_width="80.0dp" android:layout_height="wrap_content" android:text="@string/nd_goods_desc_panel_title3" style="@style/nd_goods_item_style" />
                    <TextView android:gravity="left" android:id="@id/nd_goods_buy_time_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/nd_goods_item_style" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:gravity="fill_horizontal" android:layout_width="80.0dp" android:layout_height="wrap_content" android:text="@string/nd_goods_desc_panel_title4" style="@style/nd_goods_item_style" />
                    <TextView android:gravity="left" android:id="@id/nd_goods_buy_max_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/nd_goods_item_style" />
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:gravity="fill" android:layout_width="80.0dp" android:layout_height="wrap_content" android:text="@string/nd_goods_desc_panel_title5" style="@style/nd_goods_item_style" />
                    <TextView android:gravity="left" android:id="@id/nd_goods_desc_txt" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/nd_goods_item_style" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <ProgressBar android:id="@id/nd_payprogress" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminate="true" android:layout_centerInParent="true" style="?android:attr/progressBarStyleLarge" />
</RelativeLayout>
