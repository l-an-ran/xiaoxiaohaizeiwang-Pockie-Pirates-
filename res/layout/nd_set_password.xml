<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:id="@id/nd_set_password_layout" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/nd3_option_margin_top" style="@style/nd3_option_margin_style">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd_set_password_password" style="@style/nd3_option_textview_style" />
            <EditText android:id="@id/nd_set_password_old" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nd_set_password_password_hint" android:singleLine="true" android:maxLength="12" android:layout_weight="1.0" android:inputType="textPassword" style="@style/nd3_option_edittext_style" />
        </LinearLayout>
        <ImageView android:background="@drawable/nd3_horizontal_line" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd_set_password_password_again" style="@style/nd3_option_textview_style" />
            <EditText android:id="@id/nd_set_password_new" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="" android:singleLine="true" android:maxLength="12" android:layout_weight="1.0" android:inputType="textPassword" style="@style/nd3_option_edittext_style" />
        </LinearLayout>
    </LinearLayout>
    <Button android:textColor="@color/nd3_white" android:layout_gravity="center" android:id="@id/nd_set_password_confirm" android:background="@drawable/nd_blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd_set_password_submit" style="@style/nd3_option_margin_style" />
</LinearLayout>
