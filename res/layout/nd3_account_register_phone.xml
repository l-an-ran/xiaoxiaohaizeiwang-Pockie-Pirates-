<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:id="@id/nd3_account_register_phone_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textSize="@dimen/nd3_register_agreement_text_size" android:textColor="@color/nd3_white" android:gravity="left" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/nd3_option_margin_top" android:text="@string/nd3_account_register_phone_tip" style="@style/nd3_option_margin_style" />
    <LinearLayout android:orientation="vertical" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_margin_style">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd3_account_register_tip_phone" style="@style/nd3_option_textview_style" />
            <AutoCompleteTextView android:id="@id/nd3_account_register_phone_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nd3_account_register_hint_phone" android:singleLine="true" android:maxLength="11" android:layout_weight="1.0" android:inputType="number" style="@style/nd3_option_edittext_style" />
        </LinearLayout>
        <ImageView android:background="@drawable/nd3_horizontal_line" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd3_account_register_tip_password" style="@style/nd3_option_textview_style" />
            <EditText android:id="@id/nd3_account_register_phone_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nd3_account_register_hint_password" android:singleLine="true" android:maxLength="12" android:layout_weight="1.0" style="@style/nd3_option_edittext_style" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0.0dp" style="@style/nd3_option_margin_style">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd3_account_register_tip_code" style="@style/nd3_option_textview_style" />
            <AutoCompleteTextView android:id="@id/nd3_account_register_phone_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nd3_account_register_hint_code" android:singleLine="true" android:maxLength="70" android:layout_weight="1.0" style="@style/nd3_option_edittext_style" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_margin_style">
        <CheckBox android:id="@id/nd3_account_register_phone_is_agree" android:background="@drawable/nd3_square_checkbox_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:button="@null" />
        <TextView android:textSize="@dimen/nd3_register_agreement_text_size" android:textColor="@color/nd3_white" android:id="@id/nd3_account_register_phone_agreement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/nd3_option_item_marginLeft" android:text="@string/nd3_account_register_agreement" />
    </LinearLayout>
    <Button android:id="@id/nd3_account_register_phone_gain" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nd3_account_register_button_gain_code" style="@style/nd3_option_margin_style" />
</LinearLayout>
