<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/nd3_sina_sperator_line_id" android:background="@drawable/nd3_horizontal_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/nd3_item_divider" />
    <RelativeLayout android:id="@id/nd3_invite_sinafriend_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/nd3_item_divider" android:layout_marginRight="@dimen/nd3_margin_size">
        <ImageView android:id="@id/nd3_sina_image_id" android:layout_width="@dimen/nd3_platform_image_size" android:layout_height="@dimen/nd3_platform_image_size" android:layout_marginRight="@dimen/nd3_item_divider" android:src="@drawable/nd3_3rd_platform_icon" android:scaleType="fitXY" android:layout_alignParentLeft="true" android:layout_centerVertical="true" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toRightOf="@id/nd3_sina_image_id" android:layout_alignParentRight="true" android:layout_centerVertical="true">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/nd3_more_account_bind_layout" android:visibility="visible" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1.0">
                <TextView android:id="@id/nd3_name_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_toLeftOf="@id/nd3_swtich_image" android:layout_toRightOf="@id/nd3_sina_image_id" android:layout_centerVertical="true" style="@style/nd3_option_textview_style" />
                <TextView android:textStyle="bold" android:textColor="#ff0000ff" android:ellipsize="end" android:id="@id/nd3_more_account_other_binded_title" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/nd3_option_item_marginLeft" android:text="@string/nd3_more_account_other_login" android:singleLine="true" />
                <ImageView android:id="@id/nd3_swtich_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/nd3_switch_image" android:layout_alignParentRight="true" android:layout_centerVertical="true" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:id="@id/nd3_more_account_cannot_bind_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1.0">
                <TextView android:id="@id/nd3_more_account_cannot_bind_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nd3_more_account_other_login" android:layout_weight="1.0" style="@style/nd3_option_textview_style" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nd3_more_account_cannot_bind" style="@style/nd3_option_textview_style" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>
