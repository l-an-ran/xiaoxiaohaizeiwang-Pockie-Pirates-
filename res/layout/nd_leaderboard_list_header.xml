                <RadioButton android:textColor="@color/nd3_black" android:gravity="center" android:id="@id/nd3_all_rank_btn_landscape" android:background="@drawable/nd_leaderboard_left_btn_bg" android:layout_width="60.0dp" android:layout_height="30.0dp" android:button="@null" android:text="@string/nd_leaderboard_all_player" />
                <RadioButton android:textColor="@color/nd3_black" android:gravity="center" android:id="@id/nd3_friend_rank_btn_landscape" android:background="@drawable/nd_leaderboard_right_btn_bg" android:layout_width="60.0dp" android:layout_height="30.0dp" android:button="@null" android:text="@string/nd_leaderboard_friend_player" />
            </RadioGroup>
