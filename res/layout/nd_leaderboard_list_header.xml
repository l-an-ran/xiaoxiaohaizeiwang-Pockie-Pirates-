        <RadioButton android:textColor="@color/nd3_btn_font_color" android:gravity="center" android:id="@id/nd_rank_time_type_week_btn" android:background="@drawable/nd3_rank_choice_middle_btn_bg" android:layout_width="0.0dp" android:layout_height="wrap_content" android:button="@null" android:text="@string/nd_leaderboard_scope_time_week" android:layout_weight="1.0" />
        <RadioButton android:textColor="@color/nd3_btn_font_color" android:gravity="center" android:id="@id/nd_rank_time_type_all_btn" android:background="@drawable/nd3_rank_choice_right_btn_bg" android:layout_width="0.0dp" android:layout_height="wrap_content" android:button="@null" android:text="@string/nd_leaderboard_scope_time_all" android:layout_weight="1.0" />
