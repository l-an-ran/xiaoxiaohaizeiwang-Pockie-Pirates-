<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include android:id="@id/nd3_activity_head_layout" android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/nd3_activity_head_reg" />
    <ScrollView android:fadingEdge="none" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_below="@id/nd3_activity_head_layout">
        <LinearLayout android:orientation="vertical" android:background="@color/nd3_list_view_item_bg_1" android:layout_width="match_parent" android:layout_height="match_parent">
            <RelativeLayout android:id="@id/nd3_activity_content_1_rl" android:background="@drawable/nd3_activity_action_above_bg" android:padding="@dimen/nd3_option_item_marginLeft" android:layout_width="match_parent" android:layout_height="wrap_content">
                <include android:id="@id/nd3_activity_content_plus_image" android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/nd3_activity_content_reg_template_1" />
            </RelativeLayout>
            <RelativeLayout android:id="@id/nd3_activity_content_2_rl" android:padding="@dimen/nd3_option_item_marginLeft" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_below="@id/nd3_activity_content_1_rl">
                <Button android:textColor="@color/nd3_black" android:gravity="center" android:id="@id/nd3_activity_content_action_btn" android:background="@drawable/nd3_button_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/nd3_option_item_marginLeft" android:layout_alignParentTop="true" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
