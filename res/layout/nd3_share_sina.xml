<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:padding="@dimen/nd3_margin_size" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/nd3_option_item_marginLeft">
        <FrameLayout android:id="@id/nd3_more_info_portrait_layout" android:background="@drawable/nd3_default_portrait" android:layout_width="57.0dp" android:layout_height="57.0dp" android:layout_marginTop="@dimen/nd3_option_margin_top" style="@style/nd3_option_margin_style">
            <TextView android:textSize="@dimen/nd3_portrait_add_text_size" android:textColor="@color/nd3_portrait_add_color" android:gravity="center" android:layout_gravity="center" android:id="@id/nd3_more_info_portrait_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd3_more_info_photo_add" />
            <ImageView android:id="@id/nd3_photo_share" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" />
            <TextView android:textColor="@color/nd3_white" android:gravity="center|bottom" android:layout_gravity="center|bottom" android:id="@id/nd3_more_info_portrait_edit" android:background="@drawable/nd3_portrait_edit_bg" android:visibility="visible" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/nd3_more_info_portrait_edit" />
        </FrameLayout>
        <EditText android:scrollbarAlwaysDrawVerticalTrack="true" android:scrollbarStyle="outsideOverlay" android:textColorHint="@color/nd3_hint" android:gravity="top" android:id="@id/nd3_write_message" android:background="@null" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/nd3_item_divider" android:minLines="6" android:singleLine="false" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/nd3_bind_third_account" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/nd3_option_item_marginLeft" />
    <LinearLayout android:orientation="vertical" android:id="@id/nd3_bind_third_account_timeout_parent" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textColor="@color/nd3_white" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nd3_bind_account_timeout_tip" />
        <LinearLayout android:orientation="vertical" android:id="@id/nd3_bind_third_account_timeout" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/nd3_unbind_third_account_parent" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textColor="@color/nd3_white" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nd3_bind_third_account_tip" />
        <LinearLayout android:orientation="vertical" android:id="@id/nd3_unbind_third_account" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
