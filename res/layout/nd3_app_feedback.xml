        <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:src="@drawable/nd3_horizontal_line" android:scaleType="fitXY" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/nd3_btn_text_size" android:textColor="@color/nd3_black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5.0dp" android:text="@string/nd3_app_feedback_service_phone" />
            <TextView android:textSize="@dimen/nd3_btn_text_size" android:textColor="@color/nd3_blue" android:id="@id/nd3_servicephone_txt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5.0dp" android:text="" android:singleLine="true" android:layout_below="@id/nd3_appname_txt" android:layout_alignLeft="@id/nd3_appname_txt" />
