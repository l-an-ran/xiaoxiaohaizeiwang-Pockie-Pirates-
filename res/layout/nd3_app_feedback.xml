            <RadioButton android:textColor="@color/nd3_black" android:id="@id/nd3_problem_feedback_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="7.0dp" android:button="@drawable/nd3_regist_checked" android:text="@string/nd3_app_feedback_sub_type_2" />
