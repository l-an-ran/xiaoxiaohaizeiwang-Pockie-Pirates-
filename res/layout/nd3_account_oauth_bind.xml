<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:id="@id/nd3_account_bind_bind_layout" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textSize="@dimen/nd3_pay_tip_text_size" android:textColor="@color/nd3_white" android:gravity="center" android:id="@id/nd3_account_bind_bind_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/nd3_option_margin_top" android:text="@string/nd3_account_bind_bind_content" style="@style/nd3_option_margin_style" />
    <LinearLayout android:orientation="vertical" android:background="@drawable/nd3_bk1" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_margin_style">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd3_account_bind_bind_tip_account" style="@style/nd3_option_textview_style" />
            <AutoCompleteTextView android:id="@id/nd3_account_bind_bind_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nd3_account_bind_bind_hint_account" android:singleLine="true" android:layout_weight="1.0" style="@style/nd3_option_edittext_style" />
            <ImageView android:id="@id/nd3_account_bind_bind_more" android:paddingLeft="@dimen/nd3_margin_size" android:paddingRight="@dimen/nd3_margin_size" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/nd3_icon_01" />
        </LinearLayout>
        <ImageView android:background="@drawable/nd3_horizontal_line" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/nd3_option_item_margin_style">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nd3_account_bind_bind_tip_password" style="@style/nd3_option_textview_style" />
            <EditText android:id="@id/nd3_account_bind_bind_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nd3_account_bind_bind_hint_password" android:singleLine="true" android:layout_weight="1.0" android:inputType="textPassword" style="@style/nd3_option_edittext_style" />
        </LinearLayout>
    </LinearLayout>
    <Button android:textSize="@dimen/nd3_logout_text_size" android:textColor="@color/nd3_white" android:id="@id/nd3_account_bind_bind_complete" android:background="@drawable/nd3_button_logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nd3_account_bind_bind_complete" style="@style/nd3_option_margin_style" />
</LinearLayout>
