# ==========================================
# 操作系统与编辑器临时文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.code-workspace
.vscode/
.idea/

# ==========================================
# Android / Apktool 构建产物
# ==========================================
/build/
*.apk
*.ap_
*.dex

# ==========================================
# Python 运行缓存
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
.venv/

# ==========================================
# 服务端运行时抓包、日志与备份
# ==========================================
# 离线服务抓包与动态快照（避免产生数万个文件）
offline-server/captures/
captures/

# 日志与备份文件
*.log
offline-server/*.log
*.bak
*.tmp

# ==========================================
# 调试与测试截图（注意：保留 res/ 与 assets/ 内游戏资源图）
# ==========================================
/*.png
offline-server/*.png
